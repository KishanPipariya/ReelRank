  "components": [
    {
      "name": "Masthead Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "A quiet masthead that keeps the site identity and profile at opposite ends.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Site\"><a class=\"ds-wordmark\" href=\"#\"><span class=\"ds-mark\">R</span><span>ReelRank</span></a><a class=\"ds-profile\" href=\"#\">Letterboxd profile</a></nav>",
      "css": ".ds-nav{height:68px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);color:var(--ink)}.ds-wordmark{display:inline-flex;align-items:center;gap:10px;color:inherit;font:600 21px var(--sans);letter-spacing:-.055em;text-decoration:none}.ds-mark{width:28px;height:28px;display:grid;place-items:center;border:1px solid var(--forest);border-radius:50%;color:var(--forest);font:italic 500 18px var(--serif)}.ds-profile{min-height:44px;display:inline-flex;align-items:center;color:var(--muted);font:12px var(--mono);text-decoration:none}.ds-profile:focus-visible{outline:3px solid var(--focus-terracotta);outline-offset:3px}"
    },
    {
      "name": "Selected Filter",
      "kind": "button",
      "refersTo": "button-filter-active",
      "description": "An active catalogue filter in evergreen with a clear pressed state.",
      "html": "<button class=\"ds-filter\" type=\"button\" aria-pressed=\"true\">Unwatched</button>",
      "css": ".ds-filter{min-height:44px;padding:0 8px;border:0;border-radius:2px;background:var(--deep-evergreen);color:var(--filter-cream);font:400 12px var(--sans);cursor:pointer;transition:background .18s ease,color .18s ease}.ds-filter:hover{background:var(--night-evergreen)}.ds-filter:focus-visible{outline:3px solid var(--focus-terracotta);outline-offset:3px}.ds-filter:active{transform:translateY(1px)}"
    },
    {
      "name": "Catalogue Search",
      "kind": "input",
      "refersTo": "input-search",
      "description": "A full-width porcelain search field with a visible keyboard shortcut.",
      "html": "<label class=\"ds-search\"><span aria-hidden=\"true\">⌕</span><input type=\"search\" placeholder=\"Search these films\" aria-label=\"Search these films\" /><kbd>/</kbd></label>",
      "css": ".ds-search{height:44px;display:flex;align-items:center;gap:8px;padding:0 10px;border:1px solid var(--control-border);border-radius:2px;background:var(--surface);color:var(--ink)}.ds-search input{width:100%;min-width:0;min-height:32px;border:0;outline:0;background:transparent;color:inherit;font:400 14px var(--sans)}.ds-search input::placeholder{color:var(--muted-copy);opacity:1}.ds-search kbd{color:var(--muted-copy);font:12px var(--mono)}.ds-search:focus-within{outline:3px solid var(--focus-terracotta);outline-offset:3px}"
    },
    {
      "name": "Genre Chip",
      "kind": "chip",
      "refersTo": "chip-genre",
      "description": "A tactile genre filter with a clear selected state.",
      "html": "<button class=\"ds-chip\" type=\"button\" aria-pressed=\"false\">Drama</button>",
      "css": ".ds-chip{min-height:32px;display:inline-flex;align-items:center;padding:3px 8px;border:1px solid var(--line);border-radius:999px;background:var(--surface-soft);color:var(--control-ink);font:400 12px/1.25 var(--sans);cursor:pointer}.ds-chip:hover,.ds-chip[aria-pressed=true]{border-color:var(--forest);background:var(--filter-active);color:var(--filter-active-ink)}.ds-chip:focus-visible{outline:3px solid var(--focus-terracotta);outline-offset:3px}"
    },
    {
      "name": "Poster Metadata Panel",
      "kind": "card",
      "refersTo": "poster-info",
      "description": "A flat paper panel for film title, credits, counts, and genre tags.",
      "html": "<article class=\"ds-film\"><h3>The Third Man <span>1949</span></h3><p>Directed by Carol Reed</p><strong>Appears in 32 liked lists</strong></article>",
      "css": ".ds-film{padding:11px 10px 10px;border:1px solid var(--line);border-top:0;border-radius:2px 2px 0 0;background:var(--surface);color:var(--ink)}.ds-film h3{margin:0;color:var(--ink);font:500 15px/1.32 var(--serif)}.ds-film h3 span{float:right;color:var(--muted);font:400 12px var(--mono)}.ds-film p{margin:5px 0 0;color:var(--forest);font:400 12px/1.4 var(--sans)}.ds-film strong{display:block;margin-top:8px;color:var(--forest);font:500 23px var(--serif)}"
    },
    {
      "name": "Setup Card",
      "kind": "card",
      "refersTo": "setup-card",
      "description": "An information card for configuration and recovery states.",
      "html": "<section class=\"ds-setup\"><strong>ReelRank</strong><h2>Preparing your ReelRank</h2><p>Checking the configured Letterboxd profile and snapshot.</p><button type=\"button\">Retry loading</button></section>",
      "css": ".ds-setup{width:min(620px,100%);padding:clamp(26px,6vw,54px);border:1px solid var(--line);border-radius:2px;background:var(--surface);color:var(--ink);box-shadow:0 18px 55px #24251d10}.ds-setup strong{font:600 21px var(--sans)}.ds-setup h2{margin:32px 0 0;font:500 36px/1.05 var(--serif)}.ds-setup p{margin:12px 0 0;color:var(--muted);font:400 14px/1.7 var(--sans)}.ds-setup button{min-height:44px;margin-top:20px;padding:0 12px;border:1px solid var(--control-border);border-radius:2px;background:var(--surface);color:var(--forest);font:400 12px var(--mono);cursor:pointer}.ds-setup button:focus-visible{outline:3px solid var(--focus-terracotta);outline-offset:3px}"
    },
    {
      "name": "Catalogue Hero",
      "kind": "custom",
      "refersTo": "hero-panel",
      "description": "Evergreen framing, a sans-serif headline, edition details, and the circular almanac stamp.",
      "html": "<section class=\"ds-hero\"><div class=\"ds-hero-copy\"><h1>The films that keep showing up.</h1><p>A signal from the public Letterboxd lists you like. Films rise as they appear across more lists.</p><a href=\"#\">How the ranking works</a><div>Catalogue edition · Oct 30, 2026</div></div><div class=\"ds-stamp\"><span>A personal</span><strong>film<br />almanac</strong><span>LB · INTELKISHAN</span></div></section>",
      "css": ".ds-hero{min-height:176px;position:relative;display:flex;align-items:center;justify-content:space-between;gap:clamp(16px,3vw,32px);overflow:hidden;padding:20px 7%;background:var(--forest);color:var(--hero-cream);box-shadow:inset 0 13px 0 #11171130,inset 0 -13px 0 #11171130}.ds-hero-copy{min-width:0;max-width:840px;position:relative;z-index:1;display:flex;flex:1 1 0;flex-direction:column;align-items:flex-start;gap:12px}.ds-hero h1{margin:0;color:var(--hero-cream);font:500 clamp(48px,4.5vw,64px)/.98 var(--sans);letter-spacing:-.04em}.ds-hero p{max-width:min(70ch,100%);margin:0;color:var(--hero-copy);font:400 14px/1.45 var(--sans)}.ds-hero a{min-height:44px;display:inline-flex;align-items:center;color:var(--terracotta-on-dark);font:400 12px var(--mono);text-decoration:underline;text-underline-offset:4px}.ds-hero a:hover{color:#ffc19e}.ds-hero a:focus-visible{outline:3px solid var(--hero-secondary);outline-offset:3px}.ds-stamp{width:176px;height:176px;flex:0 0 auto;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid #d4e6c755;border-radius:50%;color:#c8d5c1;text-align:center;transform:rotate(5deg)}.ds-stamp strong{margin:8px 0;color:var(--night-highlight);font:italic 500 24px/1.03 var(--serif)}.ds-stamp span{font:400 8px var(--mono);letter-spacing:.15em;text-transform:uppercase}@media(max-width:700px){.ds-hero{min-height:250px;padding:18px 22px}.ds-hero h1{font-size:clamp(36px,9vw,48px);line-height:1.02}.ds-stamp{display:none}}"
