{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "username", "profile_url", "refreshed_at", "list_count", "film_count", "displayed_film_count", "unwatched_count", "displayed_unwatched_count", "tmdb_match_count", "films"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "username": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "profile_url": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "refreshed_at": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "poster_gallery_url": { "type": "string", "pattern": "^/data/poster-galleries-[A-Za-z0-9T_Z.-]+\\.json$" },
    "list_count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "film_count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "displayed_film_count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "unwatched_count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "displayed_unwatched_count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "tmdb_match_count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "films": { "type": "array", "items": { "$ref": "#/$defs/film" } },
    "source_lists": { "$ref": "#/$defs/stringArray" }
  },
  "$defs": {
    "stringArray": { "type": "array", "items": { "type": "string" } },
    "film": {
      "type": "object",
      "required": ["title", "year", "letterboxd_title", "letterboxd_year", "letterboxd_url", "poster_url", "backdrop_url", "overview", "tmdb_url", "watched", "liked_in", "genres"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "year": { "type": "string" },
        "letterboxd_title": { "type": "string" },
        "letterboxd_year": { "type": "string" },
        "letterboxd_url": { "type": "string" },
        "poster_url": { "type": "string" },
        "backdrop_url": { "type": "string" },
        "overview": { "type": "string" },
        "tmdb_url": { "type": "string" },
        "watched": { "type": "boolean" },
        "liked_in": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "genres": { "$ref": "#/$defs/stringArray" },
        "lists": { "$ref": "#/$defs/stringArray" },
        "list_ids": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } },
        "directors": { "$ref": "#/$defs/stringArray" },
        "countries": { "$ref": "#/$defs/stringArray" },
        "original_title": { "type": "string" },
        "original_language": { "type": "string" },
        "runtime_minutes": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, { "type": "null" }] },
        "tmdb_id": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, { "type": "null" }] },
        "tmdb_rating": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
        "metadata_source": { "enum": ["", "legacy", "letterboxd", "title_match"] },
        "metadata_status": { "enum": ["unavailable", "id_only", "complete", "partial"] },
        "metadata_fetched_at": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
